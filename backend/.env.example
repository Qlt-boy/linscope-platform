# 复制成 .env 后按现场情况改
# 默认启用自签名 HTTPS；证书保存在 data/tls，随数据目录迁移
NIP_TLS_ENABLED=1
NIP_AUTO_BACKUP_HOURS=24
NIP_BACKUP_KEEP=7
NIP_TLS_HOSTS=localhost,127.0.0.1,server,localhost
# 纯本地采集：不需要任何外部巡检平台地址 / 令牌。
CACHE_TTL=20
PERIOD_DAYS=7
SITE_NAME=林鉴知微平台 | LinScopePlatform
ORG_NAME=林鉴知微技术服务股份有限公司 · 网络运维中心
# 远程登录与采集的设备口令加密密钥（留空则首次启动自动生成 data/secret.key）
# NIP_SECRET_KEY=
# 首个管理员口令（留空则随机生成，写到 data/initial_admin_password.txt）
NIP_ADMIN_PASSWORD=
